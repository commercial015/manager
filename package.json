{
  "name": "smart-kisti-manager",
  "version": "28.0.0",
  "description": "Smart Kisti Manager - Stable Professional Windows 11 installment, DPS and business management",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "com.smartkisti.manager",
    "productName": "Smart Kisti Manager",
    "asar": true,
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Smart-Kisti-Manager-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smart Kisti Manager",
      "deleteAppDataOnUninstall": false
    }
  }
}